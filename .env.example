# ==========================================
# Cấu hình môi trường TalentMatch Enterprise
# Copy thành `.env` — file này không được commit.
# ==========================================

# --- LLM đám mây (tuỳ chọn) ---
# Google Gemini API Key, lấy miễn phí tại https://aistudio.google.com/
# Để trống -> hệ thống tự fallback sang Local LLM và báo rõ trên UI.
GEMINI_API_KEY=

# --- Bảo mật ---
# Token bảo vệ DELETE /api/v1/history. Đặt header `X-Admin-Token` khi gọi.
# Để trống -> endpoint xoá lịch sử mở công khai (chỉ nên để khi dev cục bộ).
APP_ADMIN_TOKEN=

# --- CORS ---
# Origin được phép gọi cross-origin, phân tách bằng dấu phẩy, ví dụ:
#   CORS_ALLOW_ORIGINS=https://hr.company.com,http://localhost:3000
# Để trống -> frontend được phục vụ cùng nguồn nên không bật CORS.
# Lưu ý: không dùng `*` chung với allow_credentials.
CORS_ALLOW_ORIGINS=
